# Environment Configuration for MediVerse Guardian X
# Copy this file to .env and update with your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL (Main Database)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mediverse_guardian
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password

# MongoDB (Unstructured Data)
MONGODB_URI=mongodb://localhost:27017/mediverse_logs
MONGODB_DATABASE=mediverse_logs

# =============================================================================
# API CONFIGURATION
# =============================================================================
# FastAPI Backend
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
DEBUG_MODE=True

# Streamlit Frontend
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501

# React/Next.js Frontend
NEXTJS_PORT=3000
NEXTJS_HOST=localhost

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Configuration
JWT_SECRET_KEY=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2 Configuration
OAUTH2_CLIENT_ID=your_oauth2_client_id
OAUTH2_CLIENT_SECRET=your_oauth2_client_secret
OAUTH2_REDIRECT_URI=http://localhost:8000/auth/callback

# Encryption
AES_ENCRYPTION_KEY=your_32_byte_encryption_key_here_exactly_32_chars!!
SALT_KEY=your_salt_key_for_password_hashing

# =============================================================================
# AI/ML CONFIGURATION
# =============================================================================
# Hugging Face API
HUGGINGFACE_API_KEY=your_huggingface_api_key
HUGGINGFACE_MODEL_CACHE_DIR=./models/cache

# IBM Watson API
IBM_WATSON_API_KEY=your_ibm_watson_api_key
IBM_WATSON_URL=https://api.us-south.natural-language-understanding.watson.cloud.ibm.com
IBM_WATSON_VERSION=2021-08-01

# OpenAI API (Optional)
OPENAI_API_KEY=your_openai_api_key

# spaCy Models
SPACY_MODEL_PATH=./models/spacy

# =============================================================================
# BLOCKCHAIN CONFIGURATION
# =============================================================================
# Ethereum Configuration
ETHEREUM_NETWORK=http://localhost:8545
ETHEREUM_PRIVATE_KEY=your_ethereum_private_key
ETHEREUM_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
ETHEREUM_GAS_LIMIT=6721975

# Hyperledger Fabric Configuration
FABRIC_NETWORK_PATH=./blockchain/fabric-network
FABRIC_CHANNEL_NAME=mediverse-channel
FABRIC_CHAINCODE_NAME=mediverse-chaincode
FABRIC_USER_NAME=admin
FABRIC_USER_PASSWORD=adminpw

# =============================================================================
# COMPLIANCE CONFIGURATION
# =============================================================================
# HIPAA Compliance Settings
HIPAA_AUDIT_ENABLED=True
HIPAA_ENCRYPTION_REQUIRED=True
HIPAA_RETENTION_DAYS=2555  # 7 years
HIPAA_LOG_LEVEL=INFO

# Privacy Settings
DATA_ANONYMIZATION_ENABLED=True
PII_DETECTION_ENABLED=True
CONSENT_TRACKING_ENABLED=True

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=True

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Elasticsearch (for logging and search)
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elasticsearch_password

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================
# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=./logs/mediverse.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Monitoring
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=True
GRAFANA_PORT=3001

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Development Settings
ENVIRONMENT=development
AUTO_RELOAD=True
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
ALLOWED_HOSTS=localhost,127.0.0.1

# Testing
TEST_DATABASE_URL=postgresql://postgres:test@localhost:5432/mediverse_test
PYTEST_WORKERS=4

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================
# Production overrides (set ENVIRONMENT=production)
# CORS_ORIGINS=https://yourdomain.com
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# DEBUG_MODE=False
# AUTO_RELOAD=False
